# NOCTRA STUDIO Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Theme Override (for development)
# Options: noctra, halloween, christmas, valentine, summer
# Leave commented out to let the active campaign be selected from the dates.
# NEXT_PUBLIC_ACTIVE_THEME=noctra

# Email (Resend) — used for welcome emails, customer receipts and owner notifications.
# Without a key, emails are simulated and logged in the server console.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. onboarding@resend.dev works for tests.
EMAIL_FROM="NOCTRA STUDIO <onboarding@resend.dev>"
# Receives a notification for every order and newsletter subscriber.
ORDER_NOTIFICATION_EMAIL=isabelle.trzopek@mail-ecv.fr

# AI customer service chatbot. Use ONE of the two providers; without a key a built-in FAQ answers.
# Set keys only in .env.local or the Vercel dashboard (Settings > Environment Variables), never in code.
# OpenRouter (takes priority if set). Set a credit limit on the key: the chat endpoint is public.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (for real payments later — currently demo checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Database (if needed for real accounts/orders)
# DATABASE_URL=postgresql://...
